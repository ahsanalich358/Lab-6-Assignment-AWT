PORT=4000
NODE_ENV=development
JWT_SECRET=csc337_super_secret_jwt_key_2026

# Database Configuration (Defaults to embedded high-performance PostgreSQL via PGlite)
# To use external PostgreSQL (e.g. Supabase, Neon, AWS RDS, local Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db
DB_DATA_DIR=./data/pgdata
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Kafka Configuration
# To use Cloud Kafka (Upstash Kafka / Aiven / Redpanda):
# KAFKA_BROKERS=your-broker.upstash.io:9092
# KAFKA_USERNAME=your-username
# KAFKA_PASSWORD=your-password
# KAFKA_SASL=true
# KAFKA_SSL=true
KAFKA_CLIENT_ID=csc337-saas-order-service
KAFKA_GROUP_ID=order-processing-group
KAFKA_TOPIC_ORDERS=tenant.orders

# Serverless Worker Simulation & Config
COLD_START_BASE_DELAY_MS=1200
WARM_START_EXECUTION_MS=35
